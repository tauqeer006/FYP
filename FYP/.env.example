# ============================================================================
# Environment Configuration File - COPY THIS TO .env AND UPDATE VALUES
# ============================================================================
# This is an example .env file. Copy it to .env and update the values
# with your actual configuration. DO NOT commit .env to version control.

# ============================================================================
# Google Gemini AI Configuration
# ============================================================================
# Required for chatbot and report generation features
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ============================================================================
# Email Configuration (Gmail)
# ============================================================================
# For sending emails from the application
# Gmail requires an app-specific password (not your regular password)
# Enable 2FA and generate app password: https://support.google.com/accounts/answer/185833
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password_here

# ============================================================================
# Django Configuration
# ============================================================================
DEBUG=True                                          # Set to False in production
SECRET_KEY=your_secret_key_here                     # Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"

# ============================================================================
# Database Configuration
# ============================================================================
# SQLite (Development only)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (Production recommended)
DATABASE_NAME=fyp_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ============================================================================
# Redis Configuration (Caching & Rate Limiting)
# ============================================================================
# Required for persistent caching and distributed rate limiting
REDIS_URL=redis://localhost:6379/1

# ============================================================================
# External ML API URLs
# ============================================================================
# URLs for external microservices (Flask APIs)
FLASK_CNN_API_URL=http://localhost:5001                # CNN API for fracture classification
FLASK_XRAY_API_URL=http://localhost:5002              # X-Ray model API
FLASK_POSE_API_URL=http://localhost:5003              # Pose estimation API

# ============================================================================
# API Configuration
# ============================================================================
API_REQUEST_TIMEOUT=30                              # Timeout for external API calls (seconds)

# ============================================================================
# Security Configuration
# ============================================================================
ALLOWED_HOSTS=*                                     # Set to your domain(s) in production
SECURE_HSTS_SECONDS=31536000                        # HSTS max age (1 year)

# ============================================================================
# Application Settings
# ============================================================================
FLASK_ENV=development                               # Set to "production" for production deployment

# ============================================================================
# Sentry Configuration (Optional - Error Tracking)
# ============================================================================
# For error tracking and performance monitoring
# Sign up at https://sentry.io/
SENTRY_DSN=

