FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# System deps minimal - only what's actually needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install only the minimal dependencies actually used
COPY requirements-minimal.txt .
RUN pip install --no-cache-dir --timeout 1000 --require-hashes=false -r requirements-minimal.txt || pip install --no-cache-dir --timeout 1000 -r requirements-minimal.txt

# Copy only the Django app
COPY FYP/ ./

# Ensure media dir and staticfiles dir exist
RUN mkdir -p media/reports logs staticfiles

EXPOSE 8000

# Run migrations at startup
CMD ["sh", "-c", "python manage.py migrate --noinput 2>/dev/null || true && python manage.py runserver 0.0.0.0:8888"]
